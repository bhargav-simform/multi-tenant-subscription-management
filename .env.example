# ─ Shared ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─ PostgreSQL ────────────────────────────────────────────
# One database. docker/postgres/init.sh creates it plus the three roles on first boot.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-locally
DB_NAME=app_db
# The backend connects as app_user (DML only, NOBYPASSRLS — checked at boot).
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-locally
# The migrator container connects as app_migrator (DDL only).
MIGRATOR_DB_USER=app_migrator
MIGRATOR_DB_PASSWORD=change-me-locally
# Optional overrides; when unset, both URLs are assembled from the values above.
# DATABASE_URL=postgresql://app_user:change-me-locally@localhost:5432/app_db
# MIGRATOR_DATABASE_URL=postgresql://app_migrator:change-me-locally@localhost:5432/app_db

# ─ Tokens ────────────────────────────────────────────────
JWT_SECRET=dev-only-replace-me
JWT_ACCESS_EXPIRES_IN=15m
# Must be a whole number of days, e.g. 7d.
JWT_REFRESH_EXPIRES_IN=7d

# ─ Security ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5178
# Rate limiting (in memory, per backend process) — 'default' covers ordinary
# traffic, 'strict' covers the unauthenticated write routes (/auth/login,
# /auth/refresh, /onboarding/signup), which cost real work (an argon2 verify, a
# whole onboarding saga) for an anonymous caller.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_STRICT_TTL_MS=60000
THROTTLE_STRICT_LIMIT=10

# ─ Platform admin seed ───────────────────────────────────
# Seeded by the migrator as a `credentials` row with organization_id NULL — that
# single column is what makes login return the platform_admin role. There is no
# users row: a platform admin belongs to no organisation. Minimum 12 characters.
# Leave PLATFORM_ADMIN_PASSWORD empty to skip the seed.
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=change-me-platform-admin

# ─ Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
