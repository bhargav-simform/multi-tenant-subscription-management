# ─ Shared ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─ PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-locally
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-locally
MIGRATOR_DB_USER=app_migrator
MIGRATOR_DB_PASSWORD=change-me-locally

TENANT_DB_NAME=tenant_db
AUTH_DB_NAME=auth_db
CORE_DB_NAME=core_db
RESOURCE_DB_NAME=resource_db
AUDIT_DB_NAME=audit_db

# ─ Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─ Kafka ─────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID_PREFIX=mtsm

# ─ Secrets — MUST be distinct (architecture §10.5) ───────
JWT_SECRET=dev-only-replace-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SIGNING_SECRET=dev-only-replace-me-differently
INTERNAL_CONTEXT_TTL_SECONDS=30

# ─ Security ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=5

# ─ Argon2 ────────────────────────────────────────────────
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ─ Internal service URLs (docker-compose service names) ──
AUTH_SERVICE_URL=http://auth-service:3002
TENANT_SERVICE_URL=http://tenant-service:3001
USER_SERVICE_URL=http://user-service:3003
SUBSCRIPTION_SERVICE_URL=http://subscription-service:3004
RESOURCE_SERVICE_URL=http://resource-service:3005
AUDIT_SERVICE_URL=http://audit-service:3006

# ─ Per-service ports ─────────────────────────────────────
# PORT is set per-service in docker-compose.yml's `environment:` block (each
# service listens on the port its *_SERVICE_URL above names), NOT here — a
# single shared PORT value can't be correct for seven services in one file.
# Local (non-docker) runs: export PORT=<n> matching the service you're
# starting, e.g. `PORT=3001 pnpm --filter tenant-service start`.

# ─ Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
