{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": { "tsConfigPath": "apps/api-gateway/tsconfig.app.json" }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": { "tsConfigPath": "apps/auth-service/tsconfig.app.json" }
    },
    "tenant-service": {
      "type": "application",
      "root": "apps/tenant-service",
      "entryFile": "main",
      "sourceRoot": "apps/tenant-service/src",
      "compilerOptions": { "tsConfigPath": "apps/tenant-service/tsconfig.app.json" }
    },
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": { "tsConfigPath": "apps/user-service/tsconfig.app.json" }
    },
    "subscription-service": {
      "type": "application",
      "root": "apps/subscription-service",
      "entryFile": "main",
      "sourceRoot": "apps/subscription-service/src",
      "compilerOptions": { "tsConfigPath": "apps/subscription-service/tsconfig.app.json" }
    },
    "resource-service": {
      "type": "application",
      "root": "apps/resource-service",
      "entryFile": "main",
      "sourceRoot": "apps/resource-service/src",
      "compilerOptions": { "tsConfigPath": "apps/resource-service/tsconfig.app.json" }
    },
    "audit-service": {
      "type": "application",
      "root": "apps/audit-service",
      "entryFile": "main",
      "sourceRoot": "apps/audit-service/src",
      "compilerOptions": { "tsConfigPath": "apps/audit-service/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    },
    "tenant-context": {
      "type": "library",
      "root": "libs/tenant-context",
      "entryFile": "index",
      "sourceRoot": "libs/tenant-context/src",
      "compilerOptions": { "tsConfigPath": "libs/tenant-context/tsconfig.lib.json" }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": { "tsConfigPath": "libs/database/tsconfig.lib.json" }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": { "tsConfigPath": "libs/auth/tsconfig.lib.json" }
    },
    "authorization": {
      "type": "library",
      "root": "libs/authorization",
      "entryFile": "index",
      "sourceRoot": "libs/authorization/src",
      "compilerOptions": { "tsConfigPath": "libs/authorization/tsconfig.lib.json" }
    },
    "kafka": {
      "type": "library",
      "root": "libs/kafka",
      "entryFile": "index",
      "sourceRoot": "libs/kafka/src",
      "compilerOptions": { "tsConfigPath": "libs/kafka/tsconfig.lib.json" }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": { "tsConfigPath": "libs/redis/tsconfig.lib.json" }
    },
    "logging": {
      "type": "library",
      "root": "libs/logging",
      "entryFile": "index",
      "sourceRoot": "libs/logging/src",
      "compilerOptions": { "tsConfigPath": "libs/logging/tsconfig.lib.json" }
    }
  }
}
