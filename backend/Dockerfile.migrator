# syntax=docker/dockerfile:1
#
# The one-shot `migrator` container: applies the Prisma migrations as app_migrator,
# seeds the platform admin, and EXITS. The backend waits on
# `condition: service_completed_successfully`, so it never races a schema.
#
# Single stage with dev dependencies on purpose: it runs the Prisma CLI and a
# TypeScript seed script (tsx). Short-lived and never network-exposed.

FROM node:22-alpine

RUN apk add --no-cache python3 make g++ postgresql17-client bash

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

WORKDIR /app

COPY backend/package.json backend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY backend/tsconfig.json backend/prisma.config.ts ./
COPY backend/prisma ./prisma
COPY backend/src ./src
RUN pnpm exec prisma generate

COPY docker/migrator/run-migrations.sh /usr/local/bin/run-migrations.sh

ENTRYPOINT ["/usr/local/bin/run-migrations.sh"]
