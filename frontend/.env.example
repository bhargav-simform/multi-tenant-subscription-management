# The api-gateway origin. In dev, Vite proxies /api to this target (see vite.config.ts),
# so the browser talks same-origin and the gateway needs no CORS configuration.
VITE_API_PROXY_TARGET=http://localhost:3000

# What the axios client prefixes every request with. Keep as /api to use the dev proxy.
VITE_API_BASE_URL=/api
